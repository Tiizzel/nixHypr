{
  "$schema": "https://zed.dev/schema/themes/v0.2.0.json",
  "name": "Matugen",
  "author": "Tiizzel",
  "themes": [
    {
      "name": "Matugen",
      "appearance": "dark",
      "style": {
        "text": "{{colors.on_surface.default.hex}}",
        "text.muted": "{{colors.on_surface_variant.default.hex}}",
        "modified": "{{colors.primary.default.hex}}",
        "created": "{{colors.secondary.default.hex}}",
        "deleted": "{{colors.error.default.hex}}",
        "ignored": "{{colors.outline.default.hex}}",
        "background": "{{colors.surface.default.hex}}",
        "panel.background": "{{colors.surface_container_low.default.hex}}",
        "editor.background": "{{colors.surface_container_low.default.hex}}",
        "editor.foreground": "{{colors.on_surface.default.hex}}",
        "editor.line_number": "{{colors.outline_variant.default.hex}}",
        "editor.active_line_number": "{{colors.on_surface.default.hex}}",
        "editor.gutter.background": "{{colors.surface_container_low.default.hex}}",
        "status_bar.background": "{{colors.surface_container.default.hex}}",
        "title_bar.background": "{{colors.surface_container_low.default.hex}}",
        "tab_bar.background": "{{colors.surface_container_low.default.hex}}",
        "tab.inactive_background": "{{colors.surface_container_low.default.hex}}",
        "tab.active_background": "{{colors.surface_container.default.hex}}",
        "syntax": {
          "keyword": { "color": "{{colors.primary.default.hex}}" },
          "function": { "color": "{{colors.secondary.default.hex}}" },
          "type": { "color": "{{colors.tertiary.default.hex}}" },
          "comment": { "color": "{{colors.outline.default.hex}}" },
          "string": { "color": "{{colors.primary_container.default.hex}}" },
          "property": { "color": "{{colors.secondary_fixed.default.hex}}" },
          "number": { "color": "{{colors.tertiary_fixed.default.hex}}" },
          "boolean": { "color": "{{colors.tertiary_fixed.default.hex}}" },
          "operator": { "color": "#c5c6d0" }
        }
      }
    }
  ]
}
