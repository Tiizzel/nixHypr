{
  "$schema": "https://zed.dev/schema/themes/v0.2.0.json",
  "name": "Matugen",
  "author": "Tiizzel",
  "themes": [
    {
      "name": "Matugen",
      "appearance": "dark",
      "style": {
        "text": "#e3e1e9",
        "text.muted": "#c6c6d0",
        "modified": "#b5c4ff",
        "created": "#c1c5dd",
        "deleted": "#ffb4ab",
        "ignored": "#8f909a",
        "background": "#121318",
        "panel.background": "#1a1b21",
        "editor.background": "#1a1b21",
        "editor.foreground": "#e3e1e9",
        "editor.line_number": "#45464f",
        "editor.active_line_number": "#e3e1e9",
        "editor.gutter.background": "#1a1b21",
        "status_bar.background": "#1e1f25",
        "title_bar.background": "#1a1b21",
        "tab_bar.background": "#1a1b21",
        "tab.inactive_background": "#1a1b21",
        "tab.active_background": "#1e1f25",
        "syntax": {
          "keyword": { "color": "#b5c4ff" },
          "function": { "color": "#c1c5dd" },
          "type": { "color": "#e3badb" },
          "comment": { "color": "#8f909a" },
          "string": { "color": "#344479" },
          "property": { "color": "#dee1f9" },
          "number": { "color": "#ffd7f6" },
          "boolean": { "color": "#ffd7f6" },
          "operator": { "color": "#c5c6d0" }
        }
      }
    }
  ]
}
