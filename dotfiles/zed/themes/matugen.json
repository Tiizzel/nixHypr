{
  "$schema": "https://zed.dev/schema/themes/v0.2.0.json",
  "name": "Matugen",
  "author": "Tiizzel",
  "themes": [
    {
      "name": "Matugen",
      "appearance": "dark",
      "style": {
        "text": "#eedfe2",
        "text.muted": "#d5c2c6",
        "modified": "#ffb0cc",
        "created": "#e2bdc8",
        "deleted": "#ffb4ab",
        "ignored": "#9d8c91",
        "background": "#191114",
        "panel.background": "#22191c",
        "editor.background": "#22191c",
        "editor.foreground": "#eedfe2",
        "editor.line_number": "#514347",
        "editor.active_line_number": "#eedfe2",
        "editor.gutter.background": "#22191c",
        "status_bar.background": "#261d20",
        "title_bar.background": "#22191c",
        "tab_bar.background": "#22191c",
        "tab.inactive_background": "#22191c",
        "tab.active_background": "#261d20",
        "syntax": {
          "keyword": { "color": "#ffb0cc" },
          "function": { "color": "#e2bdc8" },
          "type": { "color": "#f0bc95" },
          "comment": { "color": "#9d8c91" },
          "string": { "color": "#6f334b" },
          "property": { "color": "#ffd9e4" },
          "number": { "color": "#ffdcc3" },
          "boolean": { "color": "#ffdcc3" },
          "operator": { "color": "#c5c6d0" }
        }
      }
    }
  ]
}
