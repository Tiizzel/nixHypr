{
  "$schema": "https://zed.dev/schema/themes/v0.2.0.json",
  "name": "Matugen",
  "author": "Tiizzel",
  "themes": [
    {
      "name": "Matugen",
      "appearance": "dark",
      "style": {
        "text": "#dee3e6",
        "text.muted": "#bfc8cb",
        "modified": "#85d2e8",
        "created": "#b2cbd3",
        "deleted": "#ffb4ab",
        "ignored": "#899295",
        "background": "#0f1416",
        "panel.background": "#171c1e",
        "editor.background": "#171c1e",
        "editor.foreground": "#dee3e6",
        "editor.line_number": "#40484b",
        "editor.active_line_number": "#dee3e6",
        "editor.gutter.background": "#171c1e",
        "status_bar.background": "#1b2022",
        "title_bar.background": "#171c1e",
        "tab_bar.background": "#171c1e",
        "tab.inactive_background": "#171c1e",
        "tab.active_background": "#1b2022",
        "syntax": {
          "keyword": { "color": "#85d2e8" },
          "function": { "color": "#b2cbd3" },
          "type": { "color": "#c0c4eb" },
          "comment": { "color": "#899295" },
          "string": { "color": "#004e5d" },
          "property": { "color": "#cee7ef" },
          "number": { "color": "#dee0ff" },
          "boolean": { "color": "#dee0ff" },
          "operator": { "color": "#c5c6d0" }
        }
      }
    }
  ]
}
