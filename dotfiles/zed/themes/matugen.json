{
  "$schema": "https://zed.dev/schema/themes/v0.2.0.json",
  "name": "Matugen",
  "author": "Tiizzel",
  "themes": [
    {
      "name": "Matugen",
      "appearance": "dark",
      "style": {
        "text": "#e9e0e7",
        "text.muted": "#cec3cd",
        "modified": "#e4b7f3",
        "created": "#d4c0d7",
        "deleted": "#ffb4ab",
        "ignored": "#978e97",
        "background": "#161217",
        "panel.background": "#1f1a1f",
        "editor.background": "#1f1a1f",
        "editor.foreground": "#e9e0e7",
        "editor.line_number": "#4c444d",
        "editor.active_line_number": "#e9e0e7",
        "editor.gutter.background": "#1f1a1f",
        "status_bar.background": "#231e23",
        "title_bar.background": "#1f1a1f",
        "tab_bar.background": "#1f1a1f",
        "tab.inactive_background": "#1f1a1f",
        "tab.active_background": "#231e23",
        "syntax": {
          "keyword": { "color": "#e4b7f3" },
          "function": { "color": "#d4c0d7" },
          "type": { "color": "#f5b7b5" },
          "comment": { "color": "#978e97" },
          "string": { "color": "#5d386b" },
          "property": { "color": "#f1dcf4" },
          "number": { "color": "#ffdad8" },
          "boolean": { "color": "#ffdad8" },
          "operator": { "color": "#c5c6d0" }
        }
      }
    }
  ]
}
