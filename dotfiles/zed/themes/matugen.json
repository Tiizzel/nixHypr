{
  "$schema": "https://zed.dev/schema/themes/v0.2.0.json",
  "name": "Matugen",
  "author": "Tiizzel",
  "themes": [
    {
      "name": "Matugen",
      "appearance": "dark",
      "style": {
        "text": "#dee4e4",
        "text.muted": "#bec8ca",
        "modified": "#81d3df",
        "created": "#b1cbcf",
        "deleted": "#ffb4ab",
        "ignored": "#899294",
        "background": "#0e1415",
        "panel.background": "#171d1e",
        "editor.background": "#171d1e",
        "editor.foreground": "#dee4e4",
        "editor.line_number": "#3f484a",
        "editor.active_line_number": "#dee4e4",
        "editor.gutter.background": "#171d1e",
        "status_bar.background": "#1b2122",
        "title_bar.background": "#171d1e",
        "tab_bar.background": "#171d1e",
        "tab.inactive_background": "#171d1e",
        "tab.active_background": "#1b2122",
        "syntax": {
          "keyword": { "color": "#81d3df" },
          "function": { "color": "#b1cbcf" },
          "type": { "color": "#b9c6ea" },
          "comment": { "color": "#899294" },
          "string": { "color": "#004f56" },
          "property": { "color": "#cde7eb" },
          "number": { "color": "#d9e2ff" },
          "boolean": { "color": "#d9e2ff" },
          "operator": { "color": "#c5c6d0" }
        }
      }
    }
  ]
}
