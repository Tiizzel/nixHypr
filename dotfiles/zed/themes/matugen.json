{
  "$schema": "https://zed.dev/schema/themes/v0.2.0.json",
  "name": "Matugen",
  "author": "Tiizzel",
  "themes": [
    {
      "name": "Matugen",
      "appearance": "dark",
      "style": {
        "text": "#e0e2e8",
        "text.muted": "#c2c7ce",
        "modified": "#98ccf9",
        "created": "#b8c8da",
        "deleted": "#ffb4ab",
        "ignored": "#8c9198",
        "background": "#101418",
        "panel.background": "#181c20",
        "editor.background": "#181c20",
        "editor.foreground": "#e0e2e8",
        "editor.line_number": "#42474e",
        "editor.active_line_number": "#e0e2e8",
        "editor.gutter.background": "#181c20",
        "status_bar.background": "#1c2024",
        "title_bar.background": "#181c20",
        "tab_bar.background": "#181c20",
        "tab.inactive_background": "#181c20",
        "tab.active_background": "#1c2024",
        "syntax": {
          "keyword": { "color": "#98ccf9" },
          "function": { "color": "#b8c8da" },
          "type": { "color": "#d1bfe7" },
          "comment": { "color": "#8c9198" },
          "string": { "color": "#054b71" },
          "property": { "color": "#d4e4f6" },
          "number": { "color": "#ecdcff" },
          "boolean": { "color": "#ecdcff" },
          "operator": { "color": "#c5c6d0" }
        }
      }
    }
  ]
}
